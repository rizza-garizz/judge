NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# development: API_AUTH_MODE=dev
# production: API_AUTH_MODE=token and API_TOKEN must be at least 24 chars
API_AUTH_MODE=dev
API_TOKEN=

# Comma-separated origins. Use explicit origins in production.
CORS_ORIGIN=*

REQUEST_LOGGING=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
MAX_BODY_BYTES=1048576
AUDIT_RETENTION_DAYS=365

# Production smoke test only
SMOKE_BASE_URL=http://127.0.0.1:4000
SMOKE_API_TOKEN=
SMOKE_EXPECTED_CORS_ORIGIN=
